# Salin menjadi .env di server, lalu isi bagian bertanda <...>.
APP_NAME=RITNOVA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-ritnova>
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<user_cpanel>_ritnova
DB_USERNAME=<user_cpanel>_ritnova
DB_PASSWORD=<kata-sandi-database>

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<domain-ritnova>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun admin pertama (dibuat saat php artisan db:seed). WAJIB diganti.
RITNOVA_ADMIN_USERNAME=admin
RITNOVA_ADMIN_PASSWORD=<kata-sandi-admin-kuat>

RITNOVA_TARGET_POPULATION=
RITNOVA_LATE_POLICY=catch_up
RITNOVA_MEDIA_COMPLETION_THRESHOLD=0.95
RITNOVA_SJL_MIN_WORKDAYS=2
RITNOVA_SJL_MIN_FREE_DAYS=1
